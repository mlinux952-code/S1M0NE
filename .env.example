# Copie ce fichier en ".env" et remplis les valeurs réelles.
# NE JAMAIS committer le fichier ".env" (il est dans .gitignore).

# Emplacement des données (laisser vide pour utiliser la valeur de config.toml)
# Exemple pour utiliser le disque secondaire :
# S1MONE_DATA_DIR=/media/utilisateur/DisqueSecondaire/S1M0NE_DATA
S1MONE_DATA_DIR=

# Niveau de log : DEBUG, INFO, WARNING, ERROR, CRITICAL
S1MONE_LOG_LEVEL=

# Clés API (à ajouter au fur et à mesure des connecteurs/Phase 6 IA)
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# HUGGINGFACE_TOKEN=

# --- Phase 6 : IA conversationnelle (aucune de ces clés n'est jamais demandée par l'agent) ---
# Groq (recommandé, gratuit, sans carte bancaire) : clé sur https://console.groq.com/keys
# GROQ_API_KEY=
# OpenRouter (gratuit, sans carte bancaire) : clé sur https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Ollama (local, aucune clé) : uniquement si tu ne l'installes pas à l'adresse par défaut.
# OLLAMA_BASE_URL=
# Fournisseur utilisé par défaut par "s1mone chat" (sinon : valeur de config.toml, "groq").
# AI_DEFAULT_PROVIDER=

# --- Authentification de l'interface web (facultatif, recommandé si accessible en réseau) ---
# Si absent/vide : l'interface web reste ouverte sans mot de passe (comportement historique),
# avec un avertissement au démarrage. Si défini : un mot de passe est demandé sur /login avant
# tout accès (cookie de session signé, valable 7 jours). Choisis un mot de passe toi-même — ni
# l'agent ni un tiers ne peut le connaître ou le deviner à ta place.
# S1MONE_WEB_PASSWORD=
